{
  "name": "jordy-flores-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "typecheck": "tsc --noEmit",
    "build": "pnpm typecheck && vite build && vite build --ssr src/prerender.tsx --outDir .build && node --test scripts/photo-manifest.test.mjs && node scripts/prerender.mjs && node scripts/check-dist.mjs",
    "preview": "wrangler dev --ip 127.0.0.1 --port 4174 --local",
    "deploy:check": "wrangler deploy --dry-run",
    "deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "wrangler": "4.157.0"
  }
}
