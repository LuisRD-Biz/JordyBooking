# Copy manually to .env.whatsapp at repository root (ignored by Git).
# Keep DATABASE_URL in the existing .env. Never paste secrets into chat/screenshots.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
META_APP_SECRET=
# Generate an independent random secret with at least 32 characters.
META_WEBHOOK_VERIFY_TOKEN=
# Set the supported version shown in your Meta app; no arbitrary default.
META_GRAPH_API_VERSION=
WHATSAPP_SEND_ENABLED=false
# Set true only after actually replacing/revoking the exposed old token.
WHATSAPP_TOKEN_ROTATED=false
# Exact international WhatsApp IDs, digits only; no country-code guessing.
WHATSAPP_ALLOWED_RECIPIENTS=[]
# Explicit account/sender-scoped associations; never change the received identity.
# Each item: {"account_id":"WABA_ID","phone_number_id":"PHONE_NUMBER_ID",
#             "external_contact":"OBSERVED_WA_ID","send_recipient":"AUTHORIZED_TO"}
# Replace labels with verified values in the private file, not in this example.
WHATSAPP_RECIPIENT_BINDINGS=[]
# Only approved, zero-parameter templates in this release: ["name:language"]
WHATSAPP_APPROVED_TEMPLATES=[]
WHATSAPP_MAX_WEBHOOK_BYTES=262144
